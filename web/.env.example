# Postgres. Neon pooled URL in production (postgres://…). Unset or `pglite:./.pglite` / `pglite:memory` → local PGlite.
DATABASE_URL=
# Bearer key the PayBox plugin sends (brokered secret) for POST /api/requests, /api/splits, /api/terms. ≥16 chars.
TAB_PLUGIN_KEY=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/index-escrow.
CRON_SECRET=
# Public origin used in share links and OG URLs (no trailing slash).
NEXT_PUBLIC_BASE_URL=https://tab-pay.vercel.app
# TabEscrow on Base mainnet. Unset → deal/bet pages show "Escrow not configured".
NEXT_PUBLIC_TAB_ESCROW=0xCe8dE8f1647ED91Db4Ba9B71B9AF94e2405cbCe9
# Escrow indexer starting cursor (deploy block).
TAB_ESCROW_START_BLOCK=52738530
# Optional server RPC override, tried first. Must support eth_getLogs (mainnet.base.org does not).
BASE_RPC_URL=https://base-rpc.publicnode.com
# Optional browser RPC override for wallet reads.
NEXT_PUBLIC_BASE_RPC_URL=
